# SupabaseZombi 환경 변수 설정

# 실행 간격 (시간 단위)
RUN_INTERVAL_HOURS=24

# 랜덤 삽입 개수 범위
RANDOM_INSERT_MIN=1
RANDOM_INSERT_MAX=10

# 데이터 정리 설정
MAX_DATA_LIMIT=50
TARGET_DATA_COUNT=30

# 재시작 설정 (0 = 재시작 안함)
MAX_RUNS_BEFORE_RESTART=0

# Telegram 알림 (선택 사항)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub Actions에서 사용
# 로컬에서는 config.json 파일을 직접 사용하고,
# GitHub Actions에서는 아래 변수에 config.json의 내용을 JSON 문자열로 입력
# SUPABASE_CONFIG=[{"name":"Database 1","supabase_url":"https://xxxx.supabase.co","supabase_key":"eyJhbG...","table_name":"keep-alive"}]
SUPABASE_CONFIG=
